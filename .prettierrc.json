{
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 120,
    "endOfLine": "lf",
    "semi": true,
    "singleQuote": true,
    "quoteProps": "preserve",
    "arrowParens": "always",
    "trailingComma": "all",
    "bracketSpacing": true,
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
