{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "ES2024.ArrayBuffer", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "node", "vite/client"],
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["src", "server", "tests", "vite.config.ts", "vitest.config.ts", "shared"]
}
