{
    "name": "kraftink",
    "version": "1.1.1-dev",
    "private": true,
    "packageManager": "pnpm@11.25.0",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "dev": "node scripts/prepare-content.mjs && vite --host 127.0.0.1",
        "prepare:content": "node scripts/prepare-content.mjs",
        "build": "node scripts/prepare-content.mjs && vite build && node .github/scripts/deployment.mjs build",
        "check": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "preview": "wrangler dev",
        "db:migrate:local": "wrangler d1 migrations apply kraftink --local",
        "db:migrate:remote": "wrangler d1 migrations apply kraftink --remote",
        "deploy": "pnpm check && pnpm test && pnpm build && pnpm db:migrate:remote --config dist/kraftink/wrangler.json && wrangler deploy --config dist/kraftink/wrangler.json",
        "signing-key": "node scripts/signing-key.mjs",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@noble/hashes": "^2.0.1",
        "@otplib/plugin-crypto-web": "^13.5.0",
        "bootstrap": "5.3.8",
        "drizzle-orm": "^0.45.4",
        "fflate": "^0.8.2",
        "hono": "^4.10.0",
        "ipaddr.js": "^2.2.0",
        "marked": "^17.0.5",
        "nodemailer": "^10.3.1",
        "otplib": "^13.5.0",
        "qrcode": "^1.5.4",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router-dom": "^7.9.0",
        "semver": "^7.7.3",
        "stripe": "^23.1.0",
        "zod": "^4.1.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.66.0",
        "@cloudflare/vitest-plugin": "^1.4.11",
        "@cloudflare/workers-types": "^5.20261030.1",
        "@types/bootstrap": "^5.2.11",
        "@types/node": "^24.0.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@types/semver": "^7.7.1",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "sanitize-html": "^2.18.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^4.1.0",
        "wrangler": "^4.156.0"
    }
}
