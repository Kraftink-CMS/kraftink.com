{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "kraftink",
    "account_id": "d11b6c47ecbaf53836d84da456379491",
    "main": "server/index.ts",
    "compatibility_date": "2026-10-30",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "preview_urls": false,
    "limits": { "cpu_ms": 5000 },
    "routes": [
        { "pattern": "kraftink.com", "custom_domain": true },
        { "pattern": "www.kraftink.com", "custom_domain": true },
    ],
    "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": ["/api/*", "/", "/index.html", "/robots.txt", "/sitemap.xml"],
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "kraftink",
            "database_id": "88ad7b9c-e0fa-4dc3-be11-2f0c6c9a0a9f",
            "migrations_dir": "migrations",
        },
    ],
    "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "kraftink" }],
    "vars": {
        "APP_ORIGIN": "https://kraftink.com",
        "ENVIRONMENT": "production",
        "GITHUB_CATALOGUE_URL": "https://raw.githubusercontent.com/kraftink-cms/Market/master/catalogue.json",
        "GITHUB_RELEASES_URL": "https://api.github.com/repos/kraftink-cms/Kraftink/releases",
        "MAX_UPLOAD_BYTES": "26214400",
        "MAX_ACCOUNT_STORAGE_BYTES": "262144000",
        "MAX_TOTAL_STORAGE_BYTES": "8589934592",
        "STRIPE_LIVE_MODE": "true",
        "STRIPE_PLATFORM_ACCOUNT_ID": "acct_1UWKPAAHcafbEFrA",
    },
    "triggers": { "crons": ["17 * * * *"] },
    "observability": { "enabled": false },
}
